# Copy to deploy/.env and fill in what you have. deploy/.env is git-ignored.
#
# Every value is optional: with none of them set the container still starts and
# still answers calls, on fake clinic data and the stub voice pipeline.
# GET /health reports which mode is live. See the repository README.

# --- Platform (the organisers' API). Collected at the desk. ------------------
PLATFORM_API_KEY=
PLATFORM_API_BASE_URL=

# --- Voice pipeline. Both keys are needed for the real pipeline. -------------
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- Optional model overrides ------------------------------------------------
# OPENAI_LLM_MODEL=gpt-4.1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# DEEPGRAM_STT_MODEL=nova-3

# --- Forced modes ------------------------------------------------------------
# VORTEX_VOICE_MODE=auto    # auto | stub | pipecat
# VORTEX_CLINIC_MODE=auto   # auto | fake | live

# --- Store (Supabase / Postgres). The only persistent store. -----------------
# Runtime: the line and the board read and write through PostgREST with the
# service-role key. Server-side only — it never reaches the browser.
# Empty means nothing is persisted: calls are still answered and still
# submitted, and every board screen shows zeros.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI (Dashboard -> Project Settings -> Database -> URI), not
# the REST URL above. Only deploy/deploy-both.sh reads it, to apply
# database/supabase/migrations/ before the containers restart.
SUPABASE_DB_URL=

# --- Observability. Missing keys leave the line unchanged. -------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=hackspain
# LANGFUSE_PROJECT_URL=https://cloud.langfuse.com/project/cmu7le5go05ffad0gp2xjvxjo
# DISCORD_WEBHOOK_URL=
# DISCORD_CALLS_WEBHOOK_URL=
# DISCORD_UPDATES_WEBHOOK_URL=
