# Copy to .env. Every value is optional: with none of them set, the server runs
# on fake clinic data, a dry-run submit client and a beeps-only voice pipeline.

# --- Platform (the organisers' API). Collected at the desk. -----------------
PLATFORM_API_KEY=
PLATFORM_API_BASE_URL=https://api.example.invalid

# --- STT: Soniox real-time (console.soniox.com -> API keys). EU region. ------
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v5

# --- LLM: any OpenAI-compatible endpoint. Pick one hosted in the EU. ---------
# IONOS AI Model Hub:   https://openai.inference.de-txl.ionos.com/v1
# Nebius Token Factory: https://api.tokenfactory.nebius.com/v1
# Groq EU:              https://api.eu.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
# A small non-thinking Qwen. Model ids differ per provider: IONOS "Qwen3.5-9B"
# (check their model list), Nebius "Qwen/Qwen3-30B-A3B-Instruct-2507",
# Groq EU "qwen/qwen3-32b".
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=120
# Sends chat_template_kwargs={"enable_thinking": false}: a phone call cannot
# wait for a reasoning block. Harmless on providers that ignore it.
LLM_DISABLE_THINKING=true

# --- TTS: google (default), azure or deepgram --------------------------------
VORTEX_TTS_PROVIDER=google

# Google Cloud Text-to-Speech. The only provider with ca/gl/eu voices.
# 1. console.cloud.google.com -> create or pick a project
# 2. enable the Cloud Text-to-Speech API on it
# 3. IAM -> service accounts -> new key -> JSON; save it as google-tts.json
#    (gitignored) next to this file, or paste the JSON into
#    GOOGLE_TTS_CREDENTIALS_JSON on a host with no filesystem to spare.
GOOGLE_APPLICATION_CREDENTIALS=google-tts.json
GOOGLE_TTS_CREDENTIALS_JSON=
# Spanish is a Chirp 3 HD voice; ca/gl/eu only exist as Standard voices.
GOOGLE_TTS_VOICE_ES=es-ES-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_CA=ca-ES-Standard-B
GOOGLE_TTS_VOICE_GL=gl-ES-Standard-A
GOOGLE_TTS_VOICE_EU=eu-ES-Standard-A

# Azure Neural streaming (portal.azure.com -> Speech service -> Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE_ES=es-ES-ElviraNeural
AZURE_TTS_VOICE_CA=ca-ES-JoanaNeural

# Deepgram Aura-2 fallback (console.deepgram.com). EU endpoint.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-celeste-es
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com

# --- Server ------------------------------------------------------------------
VORTEX_HOST=0.0.0.0
VORTEX_PORT=7860
VORTEX_WS_PATH=/ws

# --- Forced modes (auto derives them from the keys above) --------------------
# VORTEX_VOICE_MODE=auto    # auto | stub | pipecat
# VORTEX_CLINIC_MODE=auto   # auto | fake | live

# --- Observability -----------------------------------------------------------
VORTEX_CALLS_LOG=logs/calls.jsonl
