# Copy to .env. Every value is optional: with none of them set, the server runs
# on fake clinic data, a dry-run submit client and a beeps-only voice pipeline.

# --- Platform (the organisers' API). Collected at the desk. -----------------
PLATFORM_API_KEY=
PLATFORM_API_BASE_URL=https://api.example.invalid

# --- Voice pipeline. Both keys are needed for the real pipeline. -------------
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
OPENAI_LLM_MODEL=gpt-4.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
DEEPGRAM_STT_MODEL=nova-3

# --- Server ------------------------------------------------------------------
VORTEX_HOST=0.0.0.0
VORTEX_PORT=7860
VORTEX_WS_PATH=/ws

# --- Forced modes (auto derives them from the keys above) --------------------
# VORTEX_VOICE_MODE=auto    # auto | stub | pipecat
# VORTEX_CLINIC_MODE=auto   # auto | fake | live

# --- Observability -----------------------------------------------------------
VORTEX_CALLS_LOG=logs/calls.jsonl
VORTEX_BOARD_PORT=8080
VORTEX_LINE_URL=http://127.0.0.1:7860
# Production board (VPS): required
# VORTEX_ENV=production
# VORTEX_OPS_PASSWORD=
# VORTEX_STORAGE_SECRET=

# --- Team Discord. Channel webhook, never commit the real URL. ---------------
DISCORD_WEBHOOK_URL=
