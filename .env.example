# Copy to .env. Every value is optional: with none of them set, the server runs
# on fake clinic data, a dry-run submit client and a beeps-only voice pipeline.
# Never commit real keys — this file is the shape, not the secrets.
#
# UNVERIFIED marks a base URL or model id nobody has called yet. Check it
# against the provider's own docs before you blame the code.

# --- Platform (the organisers' API). Collected at the desk. -----------------
PLATFORM_API_KEY=
PLATFORM_API_BASE_URL=https://api.example.invalid

# --- STT: Soniox real-time (console.soniox.com -> API keys) ------------------
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v5

# =============================================================================
# LLM — the model that answers the phone
# =============================================================================
# LLM_PROVIDER picks a preset, which fills in the base URL, the key variable
# and the model id. The three LLM_* overrides below always win when set, so a
# preset is a shortcut and never a cage. Every preset reads its own key
# variable, so all of them can sit in this file at once and you switch with
# one line.
#
# LLM_PROVIDER: custom | helmcode | cloudflare | vercel   (unknown -> helmcode)
LLM_PROVIDER=helmcode

# Overrides. Empty means "take it from the preset".
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Shared by every preset.
LLM_TEMPERATURE=0.2
# 120 cut off a prepare_booking/submit_action call with a nested slot
# mid-argument, so the model's tool call never closed and nothing submitted.
# Measured on qwen3.6: submit_action with a BookAction is 107 tokens,
# prepare_booking with a full Slot is 150.
LLM_MAX_TOKENS=320
# Reasoning off, both dialects: chat_template_kwargs={"enable_thinking": false}
# (vLLM/SGLang) and reasoning_effort=none (Helmcode qwen3.6/gemma4). A phone
# call cannot wait for a reasoning block. Hosts ignore the one they don't know.
LLM_DISABLE_THINKING=true
LLM_REASONING_EFFORT=none
# Seconds one completion may go without producing its FIRST token before the
# line abandons it and re-issues it. Only the first token is on the clock: a
# slow but streaming answer is never cut. On 2026-09-18 two scored calls sat
# mute for 36 s on a request Helmcode accepted and never streamed, and the
# harness cut them. 0 disables the guard.
LLM_FIRST_TOKEN_TIMEOUT_SECS=8.0
# How many times such a request is re-issued. After the last attempt the agent
# speaks a short holding line in the language of the call instead of nothing.
LLM_RETRIES=1

# Any other role reads LLM_<ROLE>_PROVIDER / LLM_<ROLE>_MODEL and falls back
# to the receptionist above (vortex/models.py). Nothing else to wire.
#
# The bench (make bench) compares every model in evals/bench/models.yaml that
# has a key here. OPENAI_API_KEY (not a preset) adds the OpenAI reference row
# and costs about 1 EUR per full run; the Helmcode rows run on the perk.
OPENAI_API_KEY=

# --- preset: custom ----------------------------------------------------------
# Any OpenAI-compatible /v1. Uses LLM_BASE_URL, LLM_API_KEY and LLM_MODEL
# above; with LLM_MODEL empty it defaults to Qwen/Qwen3-30B-A3B-Instruct-2507.

# --- preset: helmcode (default) ----------------------------------------------
# Hackathon perk: 600M tokens, EU-hosted. Key from the Helmcode dashboard.
# Models (helmcode.com/docs/models): deepseek-v4-flash (default here: it is the
# only one of the three that passes problem 1), qwen3.6 (35B MoE, 3B active,
# fastest, but it loops its tool calls and submits nothing), gemma4, glm5.3
# (paid add-on; it fails problem 1 and problem 4 too).
HELMCODE_BASE_URL=https://api.helmcode.com/v1
HELMCODE_API_KEY=

# --- preset: cloudflare ------------------------------------------------------
# Hackathon perk: $100 of AI Gateway. dash.cloudflare.com -> Workers AI -> use
# an API token with Workers AI read/run. The account id is in the dashboard URL
# and goes into the base URL:
#   https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
# UNVERIFIED model id (@cf/qwen/qwen3-30b-a3b-fp8) — check the Workers AI catalogue.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- preset: vercel ----------------------------------------------------------
# Hackathon perk: $50 of AI Gateway. vercel.com -> AI Gateway -> API keys.
# Base URL https://ai-gateway.vercel.sh/v1, model anthropic/claude-haiku-4.5.
VERCEL_AI_GATEWAY_KEY=

# Perk with no wiring yet: fal.ai, $50 of credit (fal.ai -> keys). Nothing in
# the pipeline calls it, so there is no FAL_* variable to set.

# =============================================================================
# Arbiter — the post-hangup judge that decides what we submit
# =============================================================================
# Resolved exactly like the LLM block: a preset name plus optional overrides,
# reading the same per-preset key variables above. Nothing consumes it yet;
# it is here so the key is in place when the arbiter lane lands.
# ARBITER_PROVIDER: custom | helmcode | cloudflare | vercel
ARBITER_PROVIDER=helmcode
ARBITER_MODEL=deepseek-v4-flash
ARBITER_BASE_URL=
ARBITER_API_KEY=

# =============================================================================
# TTS — the voice, as a primary plus an alternate
# =============================================================================
# The primary speaks Spanish. The alternate speaks any language the primary
# cannot, and the pipeline routes each detected language to the one that can
# say it. Same value in both (the default) means one service and no router.
#
# google     es / ca / gl / eu
# elevenlabs es
#
# So VORTEX_TTS_PROVIDER=elevenlabs with the default alternate gives ElevenLabs
# Spanish and Google the three co-official languages.
VORTEX_TTS_PROVIDER=google
VORTEX_TTS_PROVIDER_ALT=google

# --- Google Cloud Text-to-Speech ---------------------------------------------
# The only provider here with ca/gl/eu voices.
# 1. console.cloud.google.com -> create or pick a project
# 2. enable the Cloud Text-to-Speech API on it
# 3. IAM -> service accounts -> new key -> JSON; save it as google-tts.json
#    (gitignored) next to this file, or paste the JSON into
#    GOOGLE_TTS_CREDENTIALS_JSON on a host with no filesystem to spare.
GOOGLE_APPLICATION_CREDENTIALS=google-tts.json
GOOGLE_TTS_CREDENTIALS_JSON=
# English is the clinic's default language (69 of the 73 published cases);
# Spanish is a Chirp 3 HD voice too. ca/gl/eu only exist as Standard voices.
GOOGLE_TTS_VOICE_EN=en-GB-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_ES=es-ES-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_CA=ca-ES-Standard-B
GOOGLE_TTS_VOICE_GL=gl-ES-Standard-A
GOOGLE_TTS_VOICE_EU=eu-ES-Standard-A

# --- ElevenLabs --------------------------------------------------------------
# elevenlabs.io -> profile -> API keys. There is no default voice: pick one in
# the Voice Library and paste its id, or the service builds and then fails on
# every utterance (/health reports it under tts_voices_missing).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_ES=
# Optional WebSocket origin, e.g. an AI Gateway in front of ElevenLabs.
# Empty keeps wss://api.elevenlabs.io.
ELEVENLABS_BASE_URL=

# --- Server ------------------------------------------------------------------
VORTEX_HOST=0.0.0.0
VORTEX_PORT=7860
VORTEX_WS_PATH=/ws

# --- Forced modes (auto derives them from the keys above) --------------------
# VORTEX_VOICE_MODE=auto    # auto | stub | pipecat
# VORTEX_CLINIC_MODE=auto   # auto | fake | live

# --- Observability -----------------------------------------------------------
VORTEX_CALLS_LOG=logs/calls.jsonl
VORTEX_BOARD_PORT=8080
VORTEX_LINE_URL=http://127.0.0.1:7860
# Langfuse traces one inbound call as one agent run (LLM + tools + submit).
# Missing keys leave the line unchanged. Never commit the secret key.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=hackspain
# LANGFUSE_TRACING_ENABLED=true
# Production board (VPS): required
# VORTEX_ENV=production
# VORTEX_OPS_PASSWORD=
# VORTEX_STORAGE_SECRET=

# --- Team Discord. Channel webhook, never commit the real URL. ---------------
DISCORD_WEBHOOK_URL=
