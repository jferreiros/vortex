# Copy to .env and fill in what you have. .env is git-ignored — never commit it.
#
# Every key is optional locally. With none of them set the server still starts,
# answers calls on fake clinic data through the stub voice pipeline, and
# persists nothing. GET /health reports which mode is live.
#
# The voice stack is Soniox (STT) + ElevenLabs (TTS) + an OpenAI-compatible LLM
# (Helmcode or Azure OpenAI). There is no other provider.

# --- Platform: the organisers' API (clinic reads + the submit routes) --------
PLATFORM_API_KEY=
# Defaults to http://localhost:9999.
PLATFORM_API_BASE_URL=

# --- Voice: Soniox (STT) ------------------------------------------------------
SONIOX_API_KEY=
# SONIOX_STT_MODEL=stt-rt-v5

# --- Voice: ElevenLabs (TTS) --------------------------------------------------
# One multilingual model speaks en/es/ca/gl/eu. Which voice speaks is the
# persona on the phone (conversation.language.PERSONA_VOICES, picked on the
# Clinic View) — the two ids below override that map and pin the voice to this
# machine, which GET /voice-current then reports as source=env_override.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID_DEFAULT=   # overrides the map for every language
# ELEVENLABS_VOICE_ID_ES=        # overrides it for Spanish alone
# WebSocket origin override, e.g. a gateway in front of ElevenLabs.
# ELEVENLABS_BASE_URL=

# --- Voice: modes -------------------------------------------------------------
# VORTEX_VOICE_MODE=auto     # auto | stub | pipecat
# VORTEX_CLINIC_MODE=auto    # auto | fake | live
# VORTEX_TTS_PROVIDER=elevenlabs
# Seconds of caller silence before the agent asks whether they are still there.
# VORTEX_USER_IDLE_SECS=10
# Optional ai-coustics denoiser on the Twilio input. Off unless both are set.
# VORTEX_AIC_FILTER=off
# AIC_SDK_LICENSE=
# VORTEX_AIC_MODEL=quail-ms-l-8khz

# --- LLM: pick a preset, or set the three LLM_* overrides --------------------
# LLM_PROVIDER=helmcode      # helmcode | azure
HELMCODE_API_KEY=
# HELMCODE_BASE_URL=https://api.helmcode.com/v1
# Azure OpenAI. The base URL is <endpoint>/openai/v1 with the key as bearer.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The deployment name, which is what Azure calls a model.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Only the dated API surface needs this; /openai/v1 does not.
# AZURE_OPENAI_API_VERSION=

# These three always win over the preset, whichever it is.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TEMPERATURE=0.2
# Never below 256: a smaller cap truncates a tool call mid-argument.
# LLM_MAX_TOKENS=320
# Same host as LLM_MODEL; used only on a first-token timeout. Empty disables it.
# LLM_ALT_MODEL=
# LLM_DISABLE_THINKING=true
# LLM_REASONING_EFFORT=none
# LLM_FIRST_TOKEN_TIMEOUT_SECS=8.0
# LLM_RETRIES=1

# --- Arbiter: the post-hangup submission judge --------------------------------
# ARBITER_PROVIDER=helmcode   # helmcode | azure
# ARBITER_BASE_URL=
# ARBITER_API_KEY=
# ARBITER_MODEL=deepseek-v4-flash
# VORTEX_JEV_ARBITER=0
# The JEV client (vortex/jev, evals/jev) reads this one.
# TYPESAFE_API_KEY=

# --- Store: Supabase / Postgres. The only persistent store. ------------------
# Empty = nothing is recorded; the line still answers and still submits.
# The service-role key is server-side only — it never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI (Dashboard -> Database -> URI). Only the migrator uses it.
SUPABASE_DB_URL=

# --- Observability ------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=
# LANGFUSE_PROJECT_URL=
# DISCORD_WEBHOOK_URL=
# DISCORD_CALLS_WEBHOOK_URL=
# Summarises a visit note on the Clinic View. Empty shows the note raw.
# HF_TOKEN=

# --- Twilio: SMS confirmations and outbound confirmation calls ---------------
# Both subsystems are opt-in and dry-run without the Twilio keys.
# VORTEX_SMS_CONFIRMATIONS=false
# VORTEX_CONFIRMATION_CALLS=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Prefer a Messaging Service; a bare From number also works.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=
# Demo only: send every message/call here instead of the patient's number.
# VORTEX_SMS_FORCE_TO=
# VORTEX_CONFIRMATION_FORCE_TO=
# VORTEX_SMS_DAY_BEFORE=true
# VORTEX_SMS_REMINDER_LEAD_HOURS=24
# VORTEX_SMS_REMINDER_POLL_SECS=30
# VORTEX_SMS_REMINDERS_PATH=
# VORTEX_CONFIRMATION_LEAD_HOURS=24
# VORTEX_CONFIRMATION_POLL_SECS=30
# VORTEX_CONFIRMATION_CALLS_PATH=
# Where the pre-rendered MP3s Twilio fetches are cached.
# VORTEX_CONFIRMATION_AUDIO_DIR=

# --- Server and board ---------------------------------------------------------
# VORTEX_ENV=                # production | prod requires a configured store
# VORTEX_HOST=0.0.0.0
# VORTEX_PORT=7860
# VORTEX_WS_PATH=/ws
# VORTEX_BOARD_PORT=8080
# Where the board reaches the line, and where the mic page dials it.
# VORTEX_LINE_URL=http://127.0.0.1:7860
# VORTEX_WS_URL=ws://127.0.0.1:7860/ws
# The https base Twilio fetches TwiML and audio from (the `make tunnel` host).
# VORTEX_PUBLIC_BASE_URL=
# VORTEX_WALL_URL=
# VORTEX_CLINIC_NAME=Clínica Arenal
# Required in production: the ops pages' password and the storage secret.
# VORTEX_OPS_PASSWORD=
# VORTEX_STORAGE_SECRET=
# Pin a prompt version instead of the latest on disk.
# VORTEX_PROMPT_VERSION=
# Live geocoder for problem 15. Empty = gazetteer only.
# VORTEX_GEOCODER=            # cartociudad | nominatim
# VORTEX_GEOCODER_URL=
