# syntax=docker/dockerfile:1.7
#
# Vortex — the Clinic View board: the NiceGUI ops console plus the React wall
# it serves as the product.
#
# The React app (vortex/wall) is a Vite build whose output (dist/) is
# git-ignored, so it must be compiled inside this image or /wall silently
# falls back to the classic NiceGUI view. Two stages: deps first, then the
# build, so a weekend of rapid deploys stays fast.

# ------------------------------------------------------------------ wall build
FROM node:20-bookworm-slim AS wall

WORKDIR /app/wall

# Only the lockfile first: this layer changes just when the frontend deps do.
COPY vortex/wall/package.json vortex/wall/package-lock.json ./
RUN npm ci

COPY vortex/wall ./
RUN npm run build

# ------------------------------------------------------------------- runtime
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    VORTEX_BOARD_PORT=8080 \
    VORTEX_HOST=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir nicegui httpx pydantic python-dotenv phonenumbers email-validator

COPY vortex ./vortex
# The wall's cancel buttons write through database/ (stdlib-only, no extra
# pip deps); without this COPY those routes would ImportError.
COPY database ./database
# live.py shells out to scripts/precompute_wall_cache.py at every start-up.
# Without this COPY the subprocess dies on a missing file, the occupancy
# cache is never written, and Home's occupancy card reads a flat zero.
COPY scripts ./scripts
COPY --from=wall /app/wall/dist ./vortex/wall/dist

# board-data must exist here, not just in compose.yml: Docker seeds a fresh
# named volume from the image directory it covers, owner included. Without it
# the volume is created root-owned, and the board — uid 1001 — cannot open its
# own product database ("unable to open database file") on every start-up.
RUN useradd --create-home --uid 1001 vortex \
    && mkdir -p /app/logs /app/board-data \
    && chown -R vortex:vortex /app
USER vortex

EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/wall >/dev/null || exit 1

CMD ["python", "-m", "vortex.observability.live"]