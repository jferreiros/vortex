FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VORTEX_BOARD_PORT=8080 \
    VORTEX_HOST=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY vortex ./vortex

RUN uv sync --frozen --no-dev \
    && useradd --create-home --uid 1001 vortex \
    && mkdir -p /app/logs \
    && chown -R vortex:vortex /app
USER vortex

EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/wall >/dev/null || exit 1

CMD ["uv", "run", "--frozen", "--no-dev", "python", "-m", "vortex.observability.live"]
